{
  "name": "@yamoo/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:drive": "node src/drive/pricing.check.mjs && node src/drive/search.check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:institutional": "playwright test e2e/institutional.spec.ts e2e/i18n.spec.ts",
    "test:e2e:drive": "playwright test e2e/drive.spec.ts",
    "quality": "node scripts/quality-gate.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^27.0.1",
    "lucide-react": "^0.554.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
